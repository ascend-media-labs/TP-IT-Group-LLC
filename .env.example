# Copy to .env (never commit .env).
# Local Laragon works without this file. In production DB_USER and DB_PASSWORD are required.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tpitgroup_db
# Give the website a database user limited to SELECT, INSERT, UPDATE and DELETE on this database.
# Run db:setup with a separate user that may also create and alter tables.
DB_USER=
DB_PASSWORD=

# Only if the public address differs from the address the server sees (behind a proxy).
# APP_ORIGIN=https://www.example.com

# Set to true only behind your own reverse proxy that sets X-Forwarded-For.
# TRUST_PROXY=true
